---
import '../styles/global.css';
import { DEVELOPER_INFO } from '../data/apps';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `${DEVELOPER_INFO.brandName} | Android Apps & Games Studio`,
  description = `${DEVELOPER_INFO.brandName} (${DEVELOPER_INFO.shortName}) - Estudio indie de aplicaciones y juegos Android. Explora nuestro catálogo en Google Play, capturas, soporte y novedades.`,
  ogImage = '/logo.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://nhcoders.github.io');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, canonicalURL)} />

    <link rel="author" href={DEVELOPER_INFO.playStoreDeveloperUrl} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": DEVELOPER_INFO.brandName,
      "alternateName": DEVELOPER_INFO.shortName,
      "legalName": DEVELOPER_INFO.legalName,
      "url": canonicalURL.origin,
      "logo": new URL("/logo.png", canonicalURL).href,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Santa Cruz de Tenerife",
        "addressRegion": "Canarias",
        "addressCountry": "ES"
      },
      "sameAs": [
        DEVELOPER_INFO.playStoreDeveloperUrl
      ]
    })} />
  </head>
  <body>
    <!-- Top Navigation Header -->
    <header class="site-header">
      <div class="container nav-container">
        <a href="/" class="brand-logo" aria-label="Ir al inicio de Noobs Hard Coders">
          <img
            src="/logo.png"
            alt="Logo Noobs Hard Coders"
            class="header-logo-img"
            width="140"
            height="48"
          />
        </a>

        <nav class="main-nav" aria-label="Navegación principal">
          <ul class="nav-links">
            <li><a href="/#apps" class="nav-link">Apps & Juegos</a></li>
            <li><a href="/#contacto" class="nav-link">Contacto & Soporte</a></li>
            <li><a href="/privacy" class="nav-link">Privacidad</a></li>
          </ul>
        </nav>

        <div class="header-actions">
          <a
            href={DEVELOPER_INFO.playStoreDeveloperUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-playstore header-btn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.793 12 3.61 22.186c-.36-.36-.61-.925-.61-1.637V3.451c0-.712.25-1.277.61-1.637zm11.305 9.066l2.124-2.124-9.923-5.73 7.799 7.854zm0 2.24l-7.799 7.854 9.923-5.73-2.124-2.124zm1.12-1.12l2.607 1.505c.789.456.789 1.198 0 1.654l-2.607 1.505-1.996-1.996 1.996-1.996z"/>
            </svg>
            <span>Google Play</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="site-footer">
      <div class="container footer-container">
        <div class="footer-grid">
          <!-- Col 1: Brand Info -->
          <div class="footer-col">
            <div class="footer-brand">
              <img
                src="/logo.png"
                alt="Noobs Hard Coders"
                class="footer-logo-img"
                width="160"
                height="56"
              />
              <p class="footer-tagline">{DEVELOPER_INFO.tagline}</p>
            </div>
            <p class="footer-address">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              {DEVELOPER_INFO.location}
            </p>
          </div>

          <!-- Col 2: Navigation Links -->
          <div class="footer-col">
            <h4 class="footer-heading">Navegación</h4>
            <ul class="footer-links">
              <li><a href="/#apps">Catálogo de Apps</a></li>
              <li><a href="/#contacto">Soporte & Contacto</a></li>
              <li><a href={DEVELOPER_INFO.playStoreDeveloperUrl} target="_blank" rel="noopener noreferrer">Ficha de Desarrollador</a></li>
            </ul>
          </div>

          <!-- Col 3: Legal & Compliance -->
          <div class="footer-col">
            <h4 class="footer-heading">Legal & Privacidad</h4>
            <ul class="footer-links">
              <li><a href="/privacy">Política de Privacidad</a></li>
              <li><a href="/terms">Términos de Uso</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} {DEVELOPER_INFO.brandName}. Todos los derechos reservados.</p>
          <div class="footer-badges">
            <span class="badge badge-mint">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993 0 .5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.997-3.459a.416.416 0 00-.152-.569.416.416 0 00-.569.152l-2.023 3.504c-1.396-.637-2.955-1.002-4.6345-1.002-1.68 0-3.2385.365-4.6345 1.002L5.836 5.4454a.416.416 0 00-.569-.152.416.416 0 00-.152.569l1.997 3.459C3.12 11.015 1 14.28 1 18.069h22c0-3.789-2.12-7.054-6.1185-8.7476"/>
              </svg>
              Google Play Official Developer
            </span>
          </div>
        </div>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(6, 9, 19, 0.88);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1.5px solid rgba(0, 245, 184, 0.15);
      }

      .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
      }

      .brand-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
      }

      .header-logo-img {
        height: 44px;
        width: auto;
        object-fit: contain;
        filter: drop-shadow(0 2px 10px rgba(0, 245, 184, 0.25));
        transition: transform var(--transition-fast);
      }

      .brand-logo:hover .header-logo-img {
        transform: scale(1.04);
      }

      .main-nav {
        display: flex;
      }

      .nav-links {
        display: flex;
        list-style: none;
        gap: 2rem;
      }

      .nav-link {
        font-family: var(--font-heading);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-secondary);
        transition: color var(--transition-fast);
        padding: 0.4rem 0.2rem;
        position: relative;
      }

      .nav-link:hover {
        color: var(--nhc-mint);
      }

      .nav-link:hover::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2.5px;
        background: var(--nhc-mint);
        border-radius: var(--radius-full);
        box-shadow: 0 0 8px var(--nhc-mint);
      }

      .header-btn {
        padding: 0.55rem 1.15rem;
        font-size: 0.88rem;
        border-radius: var(--radius-full);
      }

      /* Footer */
      .site-footer {
        background: #04060c;
        border-top: 1.5px solid rgba(0, 245, 184, 0.15);
        margin-top: auto;
        padding-top: 4rem;
        padding-bottom: 2.5rem;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 3rem;
        margin-bottom: 3rem;
      }

      .footer-logo-img {
        height: 52px;
        width: auto;
        object-fit: contain;
        margin-bottom: 0.85rem;
      }

      .footer-tagline {
        font-size: 0.9rem;
        max-width: 340px;
        color: var(--text-secondary);
      }

      .footer-address {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
        font-size: 0.85rem;
        color: var(--text-muted);
      }

      .footer-heading {
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 1.2rem;
        color: var(--nhc-mint);
        letter-spacing: 0.02em;
      }

      .footer-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .footer-links a {
        font-size: 0.9rem;
        color: var(--text-secondary);
        transition: color var(--transition-fast);
      }

      .footer-links a:hover {
        color: var(--nhc-mint);
      }

      .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 0.85rem;
        color: var(--text-muted);
      }

      @media (max-width: 860px) {
        .main-nav {
          display: none;
        }
        .footer-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .footer-bottom {
          flex-direction: column;
          gap: 1rem;
          text-align: center;
        }
      }
    </style>
  </body>
</html>
