---
import '../styles/global.css';
import { DEVELOPER_INFO } from '../data/apps';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title = `AtchenDev | Desarrollo Web & Apps Android (NHCoders)`,
  description = `Portfolio oficial de Atchen Valladares (AtchenDev): soluciones web de alto impacto, plataformas de reservas ERP/CRM y estudio de apps Android Noobs Hard Coders.`,
  ogImage = `${base}/logo.png`
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://atchen0027.github.io');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${base}/favicon.png`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, canonicalURL)} />

    <link rel="author" href={DEVELOPER_INFO.playStoreDeveloperUrl} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "AtchenDev",
      "alternateName": "Atchen Valladares",
      "url": canonicalURL.origin,
      "logo": new URL(`${base}/logo.png`, canonicalURL).href,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Santa Cruz de Tenerife",
        "addressRegion": "Canarias",
        "addressCountry": "ES"
      },
      "sameAs": [
        DEVELOPER_INFO.playStoreDeveloperUrl
      ]
    })} />
  </head>
  <body>
    <div class="bg-mesh-grid" aria-hidden="true"></div>

    <!-- Mouse Ambient Spotlight Layer (Desktop) -->
    <div id="ambient-spotlight" class="ambient-spotlight" aria-hidden="true"></div>

    <!-- Top Navigation Header -->
    <header class="site-header" id="main-header">
      <div class="container nav-container">
        <a href={`${base}/`} class="brand-logo" aria-label="Ir al inicio de AtchenDev">
          <span class="logo-atchen">Atchen<span class="logo-dev text-gradient-mint">.dev</span></span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="main-nav" aria-label="Navegación principal">
          <ul class="nav-links">
            <li><a href={`${base}/#servicios`} class="nav-link" data-nav-target="servicios">Servicios Web</a></li>
            <li><a href={`${base}/#apps-android`} class="nav-link nav-link-nhc" data-nav-target="apps-android">Apps Android <span class="nhc-pill">NHCoders</span></a></li>
            <li><a href={`${base}/#portfolio`} class="nav-link" data-nav-target="portfolio">Portfolio Web</a></li>
            <li><a href={`${base}/#sobre-mi`} class="nav-link" data-nav-target="sobre-mi">Sobre Mí</a></li>
            <li><a href={`${base}/#contacto`} class="nav-link" data-nav-target="contacto">Contacto</a></li>
          </ul>
        </nav>

        <div class="header-actions">
          <a
            href={`${base}/#contacto`}
            class="btn btn-mint header-btn"
          >
            <span>Pedir Presupuesto</span>
          </a>

          <button type="button" id="mobile-menu-toggle" class="mobile-toggle-btn" aria-label="Abrir menú de navegación">
            <span class="toggle-bar"></span>
            <span class="toggle-bar"></span>
          </button>
        </div>
      </div>

      <!-- Mobile Nav Drawer -->
      <div id="mobile-nav-drawer" class="mobile-nav-drawer">
        <ul class="mobile-nav-links">
          <li><a href={`${base}/#servicios`} class="mobile-nav-link">🛠️ Servicios Web</a></li>
          <li><a href={`${base}/#apps-android`} class="mobile-nav-link">📱 Apps Android (NHCoders)</a></li>
          <li><a href={`${base}/#portfolio`} class="mobile-nav-link">💻 Portfolio de Proyectos</a></li>
          <li><a href={`${base}/#sobre-mi`} class="mobile-nav-link">👨‍💻 Sobre Mí & Certificados</a></li>
          <li><a href={`${base}/#contacto`} class="mobile-nav-link">✉️ Contacto & Presupuestos</a></li>
        </ul>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="site-footer">
      <div class="container footer-container">
        <div class="footer-grid">
          <!-- Col 1: Brand Info -->
          <div class="footer-col">
            <div class="footer-brand">
              <span class="footer-logo-text">Atchen<span class="logo-dev text-gradient-mint">.dev</span></span>
              <p class="footer-tagline">Desarrollo Web Full Stack de Alto Rendimiento & Apps Android Nativas con el sello <strong>Noobs Hard Coders</strong></p>
            </div>
            <p class="footer-address">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              {DEVELOPER_INFO.location}
            </p>
          </div>

          <!-- Col 2: Navigation Links -->
          <div class="footer-col">
            <h4 class="footer-heading">Secciones</h4>
            <ul class="footer-links">
              <li><a href={`${base}/#servicios`}>Servicios & Soluciones Digitales</a></li>
              <li><a href={`${base}/#apps-android`}>Sección Android (Noobs Hard Coders)</a></li>
              <li><a href={`${base}/#portfolio`}>Portfolio de Proyectos Web</a></li>
              <li><a href={`${base}/#sobre-mi`}>Sobre Mí & Certificaciones</a></li>
              <li><a href={`${base}/#contacto`}>Contacto & Presupuestos</a></li>
            </ul>
          </div>

          <!-- Col 3: Legal & Compliance -->
          <div class="footer-col">
            <h4 class="footer-heading">Legal & Privacidad</h4>
            <ul class="footer-links">
              <li><a href={`${base}/privacy`}>Política de Privacidad</a></li>
              <li><a href={`${base}/terms`}>Términos de Uso</a></li>
              <li><a href={DEVELOPER_INFO.playStoreDeveloperUrl} target="_blank" rel="noopener noreferrer">Ficha Google Play</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} AtchenDev / Noobs Hard Coders. Todos los derechos reservados.</p>
          <div class="footer-badges">
            <span class="badge badge-mint">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.523 15.3414c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.551 0 .9993.4482.9993.9993 0 .5511-.4483.9997-.9993.9997m-11.046 0c-.5511 0-.9993-.4486-.9993-.9997s.4482-.9993.9993-.9993c.5511 0 .9993.4482.9993.9993 0 .5511-.4482.9997-.9993.9997m11.4045-6.02l1.997-3.459a.416.416 0 00-.152-.569.416.416 0 00-.569.152l-2.023 3.504c-1.396-.637-2.955-1.002-4.6345-1.002-1.68 0-3.2385.365-4.6345 1.002L5.836 5.4454a.416.416 0 00-.569-.152.416.416 0 00-.152.569l1.997 3.459C3.12 11.015 1 14.28 1 18.069h22c0-3.789-2.12-7.054-6.1185-8.7476"/>
              </svg>
              Google Play Official Developer
            </span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Interactions Script (Scroll Reveal, Mouse Spotlight, Mobile Menu, Active Section Highlight) -->
    <script>
      // 1. Scroll Reveal Observer
      const observerCallback: IntersectionObserverCallback = (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
            observer.unobserve(entry.target);
          }
        });
      };

      const revealObserver = new IntersectionObserver(observerCallback, {
        threshold: 0.12,
        rootMargin: '0px 0px -40px 0px'
      });

      document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
        revealObserver.observe(el);
      });

      // 2. Mouse Ambient Spotlight Effect (Desktop)
      const spotlight = document.getElementById('ambient-spotlight');
      if (spotlight && window.matchMedia('(pointer: fine)').matches) {
        let mouseX = 0;
        let mouseY = 0;
        let currentX = 0;
        let currentY = 0;

        window.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        }, { passive: true });

        const animateSpotlight = () => {
          currentX += (mouseX - currentX) * 0.1;
          currentY += (mouseY - currentY) * 0.1;
          spotlight.style.transform = `translate(${currentX - 250}px, ${currentY - 250}px)`;
          requestAnimationFrame(animateSpotlight);
        };
        requestAnimationFrame(animateSpotlight);
      }

      // 3. Mobile Menu Drawer Toggle
      const toggleBtn = document.getElementById('mobile-menu-toggle');
      const drawer = document.getElementById('mobile-nav-drawer');

      toggleBtn?.addEventListener('click', () => {
        const isOpen = drawer?.classList.toggle('open');
        toggleBtn.classList.toggle('active', isOpen);
      });

      document.querySelectorAll('.mobile-nav-link').forEach((link) => {
        link.addEventListener('click', () => {
          drawer?.classList.remove('open');
          toggleBtn?.classList.remove('active');
        });
      });

      // 4. Header Shadow on Scroll
      const header = document.getElementById('main-header');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          header?.classList.add('scrolled');
        } else {
          header?.classList.remove('scrolled');
        }
      }, { passive: true });
    </script>

    <style>
      .ambient-spotlight {
        position: fixed;
        top: 0;
        left: 0;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(0, 245, 184, 0.08) 0%, rgba(255, 0, 127, 0.04) 40%, transparent 70%);
        pointer-events: none;
        z-index: 1;
        mix-blend-mode: screen;
        will-change: transform;
      }

      @media (pointer: coarse) {
        .ambient-spotlight {
          display: none;
        }
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(4, 7, 17, 0.82);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        transition: border-color var(--transition-fast), background var(--transition-fast);
      }

      .site-header.scrolled {
        background: rgba(4, 7, 17, 0.95);
        border-color: rgba(0, 245, 184, 0.2);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
      }

      .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.85rem;
        padding-bottom: 0.85rem;
      }

      .brand-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
      }

      .logo-atchen {
        font-family: var(--font-heading);
        font-size: 1.45rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        color: #ffffff;
      }

      .logo-dev {
        font-family: var(--font-mono);
        font-weight: 800;
      }

      .main-nav {
        display: flex;
      }

      .nav-links {
        display: flex;
        list-style: none;
        gap: 1.4rem;
        align-items: center;
      }

      .nav-link {
        font-family: var(--font-heading);
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--text-secondary);
        transition: color var(--transition-fast);
        padding: 0.4rem 0.2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }

      .nav-link:hover {
        color: var(--nhc-mint);
      }

      .nav-link-nhc {
        color: #5effcf;
      }

      .nhc-pill {
        background: rgba(0, 245, 184, 0.15);
        color: var(--nhc-mint);
        border: 1px solid rgba(0, 245, 184, 0.3);
        font-size: 0.65rem;
        font-weight: 800;
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .header-btn {
        padding: 0.5rem 1.15rem;
        font-size: 0.85rem;
        border-radius: var(--radius-full);
      }

      .mobile-toggle-btn {
        display: none;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border-subtle);
        width: 40px;
        height: 40px;
        border-radius: var(--radius-sm);
        cursor: pointer;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 5px;
      }

      .toggle-bar {
        width: 20px;
        height: 2px;
        background: #ffffff;
        border-radius: 2px;
        transition: transform 0.3s ease;
      }

      .mobile-toggle-btn.active .toggle-bar:first-child {
        transform: translateY(3.5px) rotate(45deg);
      }
      .mobile-toggle-btn.active .toggle-bar:last-child {
        transform: translateY(-3.5px) rotate(-45deg);
      }

      .mobile-nav-drawer {
        display: none;
        background: #070c1d;
        border-top: 1px solid var(--border-subtle);
        padding: 1.25rem 1.5rem;
      }

      .mobile-nav-drawer.open {
        display: block;
      }

      .mobile-nav-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .mobile-nav-link {
        font-family: var(--font-heading);
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-primary);
        display: block;
        padding: 0.3rem 0;
      }

      .mobile-nav-link:hover {
        color: var(--nhc-mint);
      }

      /* Footer */
      .site-footer {
        background: #03050c;
        border-top: 1px solid var(--border-subtle);
        padding: 4.5rem 0 2.5rem;
        margin-top: auto;
        position: relative;
        z-index: 2;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: 3rem;
        margin-bottom: 3rem;
      }

      .footer-logo-text {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 900;
        color: #ffffff;
        display: inline-block;
        margin-bottom: 0.6rem;
      }

      .footer-tagline {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 1.25rem;
        line-height: 1.5;
      }

      .footer-tagline strong {
        color: var(--nhc-mint);
      }

      .footer-address {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-muted);
      }

      .footer-heading {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
        color: #ffffff;
      }

      .footer-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }

      .footer-links a {
        font-size: 0.85rem;
        color: var(--text-secondary);
        transition: color var(--transition-fast);
      }

      .footer-links a:hover {
        color: var(--nhc-mint);
      }

      .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 2rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 0.85rem;
        color: var(--text-muted);
        flex-wrap: wrap;
        gap: 1rem;
      }

      @media (max-width: 860px) {
        .main-nav {
          display: none;
        }
        .mobile-toggle-btn {
          display: flex;
        }
        .header-btn {
          display: none;
        }
        .footer-grid {
          grid-template-columns: 1fr;
          gap: 2rem;
        }
        .footer-bottom {
          flex-direction: column;
          text-align: center;
        }
      }
    </style>
  </body>
</html>
