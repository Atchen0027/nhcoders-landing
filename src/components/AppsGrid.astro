---
import { APPS, DEVELOPER_INFO } from '../data/apps';
import AppCard from './AppCard.astro';
import ScreenshotModal from './ScreenshotModal.astro';

const categories = [
  { id: 'todas', label: 'Todas las Apps', count: APPS.length },
  { id: 'productividad', label: 'Productividad & Utilidades', count: APPS.filter(a => a.category === 'productividad').length },
  { id: 'salud', label: 'Salud, Bienestar & Sueño', count: APPS.filter(a => a.category === 'salud').length },
  { id: 'educacion', label: 'Educación & Deportes', count: APPS.filter(a => a.category === 'educacion').length },
].filter(c => c.count > 0);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="apps-android" class="apps-section">
  <div class="container">
    <!-- Noobs Hard Coders Dedicated Studio Banner -->
    <div class="nhc-studio-header cyber-card reveal-on-scroll">
      <div class="nhc-logo-wrap">
        <img
          src={`${base}/logo.png`}
          alt="Noobs Hard Coders Mascot Logo"
          class="nhc-studio-logo"
          width="260"
          height="170"
          loading="lazy"
        />
      </div>

      <div class="nhc-studio-info">
        <div class="badges-row">
          <span class="badge badge-mint">Sello Android Indie</span>
          <span class="badge badge-pink">100% Nativo & Sin Bloatware</span>
        </div>

        <h2 class="section-title">
          Noobs Hard Coders <span class="text-gradient-mint">(NHCoders)</span>
        </h2>

        <p class="section-subtitle">
          Mi división y estudio independiente dedicado al desarrollo de <strong>aplicaciones y juegos nativos para Android</strong> publicados en Google Play Store con interfaces optimizadas y bajo consumo de recursos.
        </p>

        <div class="nhc-studio-ctas">
          <a
            href={DEVELOPER_INFO.playStoreDeveloperUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-playstore nhc-cta-btn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.793 12 3.61 22.186c-.36-.36-.61-.925-.61-1.637V3.451c0-.712.25-1.277.61-1.637zm11.305 9.066l2.124-2.124-9.923-5.73 7.799 7.854zm0 2.24l-7.799 7.854 9.923-5.73-2.124-2.124zm1.12-1.12l2.607 1.505c.789.456.789 1.198 0 1.654l-2.607 1.505-1.996-1.996 1.996-1.996z"/>
            </svg>
            <span>Ver Catálogo en Google Play</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Category Filter Tabs (Desktop & Tablet) -->
    <div class="category-filters-container reveal-on-scroll delay-1">
      <div class="category-filters" role="tablist" aria-label="Filtrar aplicaciones Android por categoría">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`filter-tab ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.id}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            <span>{cat.label}</span>
            <span class="tab-count">{cat.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Apps Container (Desktop Grid & Mobile Swipeable Autopass Carousel) -->
    <div class="apps-carousel-wrapper reveal-on-scroll delay-2">
      <!-- Carousel Edge Peek Hints (Mobile only) -->
      <button type="button" class="carousel-nav-btn prev-btn mobile-only" id="apps-carousel-prev" aria-label="Ver app anterior">
        ‹
      </button>

      <div class="apps-grid" id="apps-grid-container">
        {APPS.map((app, index) => (
          <div class="app-item-wrapper" data-app-category={app.category} data-slide-index={index}>
            <AppCard app={app} />
          </div>
        ))}
      </div>

      <button type="button" class="carousel-nav-btn next-btn mobile-only" id="apps-carousel-next" aria-label="Ver siguiente app">
        ›
      </button>
    </div>

    <!-- Mobile Carousel Indicators -->
    <div class="carousel-indicators mobile-only" id="apps-carousel-indicators">
      {APPS.map((_, idx) => (
        <button
          type="button"
          class={`indicator-dot ${idx === 0 ? 'active' : ''}`}
          data-indicator-index={idx}
          aria-label={`Ir a la aplicación ${idx + 1}`}
        ></button>
      ))}
    </div>
  </div>

  <!-- Screenshot Lightbox Modal -->
  <ScreenshotModal />
</section>

<script>
  // Category Filter
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const appCards = document.querySelectorAll<HTMLElement>('.app-item-wrapper');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const selectedCategory = btn.dataset.filter || 'todas';

      appCards.forEach((card) => {
        const cardCategory = card.dataset.appCategory;
        if (selectedCategory === 'todas' || cardCategory === selectedCategory) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Mobile Autopass & Carousel Indicators Logic
  const gridContainer = document.getElementById('apps-grid-container');
  const indicatorDots = document.querySelectorAll<HTMLButtonElement>('#apps-carousel-indicators .indicator-dot');
  const prevBtn = document.getElementById('apps-carousel-prev');
  const nextBtn = document.getElementById('apps-carousel-next');

  if (gridContainer && indicatorDots.length > 0) {
    let autoPassInterval: number | null = null;
    let isUserInteracting = false;

    // Update active dot based on scroll
    const updateActiveDot = () => {
      const scrollLeft = gridContainer.scrollLeft;
      const cardWidth = (gridContainer.firstElementChild as HTMLElement)?.offsetWidth || 280;
      const activeIdx = Math.round(scrollLeft / (cardWidth + 14));
      
      indicatorDots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === activeIdx);
      });
    };

    gridContainer.addEventListener('scroll', updateActiveDot, { passive: true });

    // Click on indicators
    indicatorDots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIdx = Number(dot.dataset.indicatorIndex);
        const card = gridContainer.children[targetIdx] as HTMLElement;
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    });

    // Arrow navigation
    prevBtn?.addEventListener('click', () => {
      const cardWidth = (gridContainer.firstElementChild as HTMLElement)?.offsetWidth || 280;
      gridContainer.scrollBy({ left: -(cardWidth + 14), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      const cardWidth = (gridContainer.firstElementChild as HTMLElement)?.offsetWidth || 280;
      gridContainer.scrollBy({ left: cardWidth + 14, behavior: 'smooth' });
    });

    // Autopass functionality (only on mobile screens)
    const startAutoPass = () => {
      if (window.innerWidth <= 768 && !autoPassInterval) {
        autoPassInterval = window.setInterval(() => {
          if (!isUserInteracting) {
            const maxScroll = gridContainer.scrollWidth - gridContainer.clientWidth;
            const cardWidth = (gridContainer.firstElementChild as HTMLElement)?.offsetWidth || 280;
            
            if (gridContainer.scrollLeft >= maxScroll - 20) {
              gridContainer.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
              gridContainer.scrollBy({ left: cardWidth + 14, behavior: 'smooth' });
            }
          }
        }, 3600);
      }
    };

    const stopAutoPass = () => {
      if (autoPassInterval) {
        clearInterval(autoPassInterval);
        autoPassInterval = null;
      }
    };

    gridContainer.addEventListener('touchstart', () => { isUserInteracting = true; }, { passive: true });
    gridContainer.addEventListener('touchend', () => {
      setTimeout(() => { isUserInteracting = false; }, 3000);
    }, { passive: true });

    gridContainer.addEventListener('mouseenter', () => { isUserInteracting = true; });
    gridContainer.addEventListener('mouseleave', () => { isUserInteracting = false; });

    startAutoPass();
    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) stopAutoPass();
      else startAutoPass();
    });
  }
</script>

<style>
  .apps-section {
    padding: 5rem 0;
    position: relative;
    contain: content;
  }

  .nhc-studio-header {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    background: rgba(9, 15, 34, 0.85);
    border: 1.5px solid rgba(0, 245, 184, 0.35);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    margin-bottom: 2.75rem;
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 245, 184, 0.15);
  }

  .nhc-logo-wrap {
    flex-shrink: 0;
    transition: transform 0.4s var(--ease-spring);
  }

  .nhc-studio-header:hover .nhc-logo-wrap {
    transform: scale(1.04) rotate(-1deg);
  }

  .nhc-studio-logo {
    max-width: 220px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0, 245, 184, 0.3));
  }

  .nhc-studio-info {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .badges-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .section-title {
    font-size: clamp(1.85rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .section-subtitle strong {
    color: var(--nhc-mint);
  }

  .nhc-studio-ctas {
    margin-top: 0.6rem;
  }

  .nhc-cta-btn {
    padding: 0.75rem 1.4rem;
    font-size: 0.92rem;
  }

  .category-filters-container {
    display: flex;
    justify-content: center;
    margin-bottom: 2.25rem;
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    background: rgba(9, 15, 34, 0.85);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-tab:hover {
    border-color: var(--nhc-mint);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .filter-tab.active {
    background: var(--nhc-mint);
    color: #040711;
    border-color: var(--nhc-mint);
    box-shadow: 0 4px 16px rgba(0, 245, 184, 0.35);
  }

  .tab-count {
    background: rgba(0, 0, 0, 0.25);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-full);
    font-size: 0.74rem;
    font-weight: 800;
  }

  /* Desktop Apps Grid */
  .apps-carousel-wrapper {
    position: relative;
    width: 100%;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  .app-item-wrapper {
    min-width: 0;
  }

  .mobile-only {
    display: none;
  }

  /* Mobile Swipeable Carousel with Autopass & Peek indicators */
  @media (max-width: 768px) {
    .mobile-only {
      display: flex;
    }

    .apps-section {
      padding: 3rem 0;
    }

    .nhc-studio-header {
      flex-direction: column;
      text-align: center;
      padding: 1.75rem 1.25rem;
      gap: 1.25rem;
      align-items: center;
      margin-bottom: 2rem;
    }

    .nhc-studio-logo {
      max-width: 160px;
    }

    .badges-row {
      justify-content: center;
    }

    .nhc-studio-ctas {
      display: flex;
      justify-content: center;
    }

    .nhc-cta-btn {
      width: 100%;
      justify-content: center;
    }

    /* Horizontal Carousel Track */
    .apps-carousel-wrapper {
      position: relative;
      margin: 0 -1rem;
      padding: 0 1rem;
    }

    .apps-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 0.9rem;
      padding: 0.5rem 0.5rem 1rem;
      scroll-padding: 0 1.25rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .apps-grid::-webkit-scrollbar {
      display: none;
    }

    .app-item-wrapper {
      flex: 0 0 76vw;
      max-width: 290px;
      scroll-snap-align: center;
      transition: transform 0.3s ease;
    }

    /* Carousel Nav Floating Buttons */
    .carousel-nav-btn {
      position: absolute;
      top: 45%;
      transform: translateY(-50%);
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(9, 15, 34, 0.92);
      border: 1px solid var(--border-mint);
      color: var(--nhc-mint);
      font-size: 1.3rem;
      font-weight: 800;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      z-index: 10;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(8px);
    }

    .prev-btn {
      left: 0.25rem;
    }

    .next-btn {
      right: 0.25rem;
    }

    /* Indicators */
    .carousel-indicators {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.45rem;
      margin-top: 0.75rem;
    }

    .indicator-dot {
      width: 8px;
      height: 8px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.2);
      border: none;
      cursor: pointer;
      padding: 0;
      transition: width 0.3s ease, background 0.3s ease;
    }

    .indicator-dot.active {
      width: 24px;
      background: var(--nhc-mint);
      box-shadow: 0 0 10px var(--nhc-mint);
    }
  }
</style>
