---
import { APPS } from '../data/apps';
import AppCard from './AppCard.astro';
import ScreenshotModal from './ScreenshotModal.astro';

const categories = [
  { id: 'todas', label: 'Todas las Apps', count: APPS.length },
  { id: 'productividad', label: 'Productividad & Utilidades', count: APPS.filter(a => a.category === 'productividad').length },
  { id: 'salud', label: 'Salud, Bienestar & Sueño', count: APPS.filter(a => a.category === 'salud').length },
  { id: 'educacion', label: 'Educación & Deportes', count: APPS.filter(a => a.category === 'educacion').length },
].filter(c => c.count > 0);
---

<section id="apps" class="apps-section">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-mint">Catálogo Android</span>
      <h2 class="section-title">Nuestras Creaciones</h2>
      <p class="section-subtitle">
        Aplicaciones y utilidades nativas para Android. Toca cualquier app para ver capturas completas o instalar desde Google Play.
      </p>

      <!-- Category Filter Tabs -->
      <div class="category-filters" role="tablist" aria-label="Filtrar aplicaciones por categoría">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`filter-tab ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.id}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            <span>{cat.label}</span>
            <span class="tab-count">{cat.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Apps Grid (3 columns on mobile and desktop) -->
    <div class="apps-grid" id="apps-grid-container">
      {APPS.map((app) => (
        <div class="app-item-wrapper" data-app-category={app.category}>
          <AppCard app={app} />
        </div>
      ))}
    </div>
  </div>

  <!-- Screenshot Lightbox Modal -->
  <ScreenshotModal />
</section>

<script>
  // Instant Category Filter
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const appCards = document.querySelectorAll<HTMLElement>('.app-item-wrapper');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const selectedCategory = btn.dataset.filter || 'todas';

      appCards.forEach((card) => {
        const cardCategory = card.dataset.appCategory;
        if (selectedCategory === 'todas' || cardCategory === selectedCategory) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .apps-section {
    padding: 4rem 0 5rem;
    position: relative;
    contain: content;
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1rem;
  }

  .filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: #0d1424;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-tab:hover {
    border-color: var(--nhc-mint);
    color: #ffffff;
  }

  .filter-tab.active {
    background: var(--nhc-mint);
    color: #060913;
    border-color: var(--nhc-mint);
    box-shadow: 0 2px 10px rgba(0, 245, 184, 0.3);
  }

  .tab-count {
    background: rgba(0, 0, 0, 0.25);
    padding: 0.08rem 0.4rem;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 800;
  }

  /* 3 Columns Grid on Desktop */
  .apps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  .app-item-wrapper {
    min-width: 0;
  }

  /* Mobile: 3 Columns Grid (Cards in rows of 3) */
  @media (max-width: 768px) {
    .apps-section {
      padding: 2.5rem 0 3.5rem;
    }

    .section-header {
      margin-bottom: 1.75rem;
    }

    .apps-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
    }

    .category-filters {
      gap: 0.35rem;
    }

    .filter-tab {
      padding: 0.4rem 0.75rem;
      font-size: 0.75rem;
    }
  }

  @media (max-width: 380px) {
    .apps-grid {
      gap: 0.35rem;
    }
  }
</style>
