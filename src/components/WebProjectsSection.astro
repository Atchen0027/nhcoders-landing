---
import { WEB_PROJECTS } from '../data/webProjects';

const categories = [
  { id: 'todos', label: 'Todos los Proyectos', count: WEB_PROJECTS.length },
  { id: 'booking', label: 'Gestores & Reservas', count: WEB_PROJECTS.filter(p => p.category === 'booking').length },
  { id: 'landings', label: 'Landings & Webs', count: WEB_PROJECTS.filter(p => p.category === 'landings').length },
  { id: 'ecommerce', label: 'E-commerce & Tiendas', count: WEB_PROJECTS.filter(p => p.category === 'ecommerce').length },
  { id: 'apps', label: 'Web Apps', count: WEB_PROJECTS.filter(p => p.category === 'apps').length },
].filter(c => c.count > 0);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="portfolio" class="portfolio-section">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <span class="badge badge-pink">AtchenDev Portfolio</span>
      <h2 class="section-title">Portfolio de Proyectos Web</h2>
      <p class="section-subtitle">
        Proyectos web reales construidos a medida: paneles de administración ERP/CRM, plataformas con motores de reserva interactivos, tiendas online y landing pages de alto impacto.
      </p>

      <!-- Category Filter Tabs (Desktop & Tablet) -->
      <div class="category-filters" role="tablist" aria-label="Filtrar proyectos web por categoría">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`filter-tab ${idx === 0 ? 'active' : ''}`}
            data-web-filter={cat.id}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            <span>{cat.label}</span>
            <span class="tab-count">{cat.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Container (Desktop Grid & Mobile Swipeable Autopass Carousel) -->
    <div class="projects-carousel-wrapper reveal-on-scroll delay-2">
      <!-- Carousel Edge Peek Hints (Mobile only) -->
      <button type="button" class="carousel-nav-btn prev-btn mobile-only" id="web-carousel-prev" aria-label="Ver proyecto anterior">
        ‹
      </button>

      <div class="projects-grid" id="web-projects-container">
        {WEB_PROJECTS.map((project, index) => {
          const imgSrc = `${base}${project.image}`;
          return (
            <article
              class={`web-project-card cyber-card reveal-on-scroll delay-${(index % 4) + 1}`}
              data-web-category={project.category}
              data-slide-index={index}
            >
              <div class="project-img-wrapper">
                <img
                  src={imgSrc}
                  alt={`Captura del proyecto ${project.title}`}
                  class="project-img"
                  loading="lazy"
                />
                <div class="project-overlay">
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-mint demo-overlay-btn"
                  >
                    <span>Ver Demo en Vivo</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </a>
                </div>
              </div>

              <div class="project-content">
                <div class="project-header">
                  <span class="badge badge-mint project-cat">{project.categoryLabel}</span>
                  {project.featured && <span class="badge badge-pink">Destacado</span>}
                </div>

                <h3 class="project-title">{project.title}</h3>
                <p class="project-desc">{project.description}</p>

                <div class="project-tags">
                  {project.tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>

                <div class="project-actions">
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-secondary project-btn"
                  >
                    <span>Explorar Proyecto</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <button type="button" class="carousel-nav-btn next-btn mobile-only" id="web-carousel-next" aria-label="Ver siguiente proyecto">
        ›
      </button>
    </div>

    <!-- Mobile Carousel Indicators -->
    <div class="carousel-indicators mobile-only" id="web-carousel-indicators">
      {WEB_PROJECTS.map((_, idx) => (
        <button
          type="button"
          class={`indicator-dot ${idx === 0 ? 'active' : ''}`}
          data-indicator-index={idx}
          aria-label={`Ir al proyecto web ${idx + 1}`}
        ></button>
      ))}
    </div>
  </div>
</section>

<script>
  // Web Category Filter Logic
  const webFilterButtons = document.querySelectorAll<HTMLButtonElement>('[data-web-filter]');
  const projectCards = document.querySelectorAll<HTMLElement>('.web-project-card');

  webFilterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      webFilterButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const filterVal = btn.dataset.webFilter || 'todos';

      projectCards.forEach((card) => {
        const cardCat = card.dataset.webCategory;
        if (filterVal === 'todos' || cardCat === filterVal) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Mobile Web Carousel Autopass & Indicators
  const webGrid = document.getElementById('web-projects-container');
  const webDots = document.querySelectorAll<HTMLButtonElement>('#web-carousel-indicators .indicator-dot');
  const webPrev = document.getElementById('web-carousel-prev');
  const webNext = document.getElementById('web-carousel-next');

  if (webGrid && webDots.length > 0) {
    let autoPassInterval: number | null = null;
    let isUserInteracting = false;

    // Update active dot based on scroll
    const updateWebDot = () => {
      const scrollLeft = webGrid.scrollLeft;
      const cardWidth = (webGrid.firstElementChild as HTMLElement)?.offsetWidth || 300;
      const activeIdx = Math.round(scrollLeft / (cardWidth + 16));
      
      webDots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === activeIdx);
      });
    };

    webGrid.addEventListener('scroll', updateWebDot, { passive: true });

    // Click on indicators
    webDots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIdx = Number(dot.dataset.indicatorIndex);
        const card = webGrid.children[targetIdx] as HTMLElement;
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    });

    // Navigation arrows
    webPrev?.addEventListener('click', () => {
      const cardWidth = (webGrid.firstElementChild as HTMLElement)?.offsetWidth || 300;
      webGrid.scrollBy({ left: -(cardWidth + 16), behavior: 'smooth' });
    });

    webNext?.addEventListener('click', () => {
      const cardWidth = (webGrid.firstElementChild as HTMLElement)?.offsetWidth || 300;
      webGrid.scrollBy({ left: cardWidth + 16, behavior: 'smooth' });
    });

    // Autopass functionality (only on mobile)
    const startWebAutoPass = () => {
      if (window.innerWidth <= 768 && !autoPassInterval) {
        autoPassInterval = window.setInterval(() => {
          if (!isUserInteracting) {
            const maxScroll = webGrid.scrollWidth - webGrid.clientWidth;
            const cardWidth = (webGrid.firstElementChild as HTMLElement)?.offsetWidth || 300;
            
            if (webGrid.scrollLeft >= maxScroll - 20) {
              webGrid.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
              webGrid.scrollBy({ left: cardWidth + 16, behavior: 'smooth' });
            }
          }
        }, 4000);
      }
    };

    const stopWebAutoPass = () => {
      if (autoPassInterval) {
        clearInterval(autoPassInterval);
        autoPassInterval = null;
      }
    };

    webGrid.addEventListener('touchstart', () => { isUserInteracting = true; }, { passive: true });
    webGrid.addEventListener('touchend', () => {
      setTimeout(() => { isUserInteracting = false; }, 3000);
    }, { passive: true });

    webGrid.addEventListener('mouseenter', () => { isUserInteracting = true; });
    webGrid.addEventListener('mouseleave', () => { isUserInteracting = false; });

    startWebAutoPass();
    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) stopWebAutoPass();
      else startWebAutoPass();
    });
  }
</script>

<style>
  .portfolio-section {
    padding: 5rem 0;
    position: relative;
    contain: content;
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.85rem, 4vw, 2.7rem);
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1.25rem;
  }

  .filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    background: rgba(9, 15, 34, 0.85);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-tab:hover {
    border-color: var(--nhc-pink);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .filter-tab.active {
    background: var(--grad-pink);
    color: #ffffff;
    border-color: var(--nhc-pink);
    box-shadow: 0 4px 16px rgba(255, 0, 127, 0.35);
  }

  .tab-count {
    background: rgba(0, 0, 0, 0.25);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-full);
    font-size: 0.74rem;
    font-weight: 800;
  }

  /* Projects Desktop Grid */
  .projects-carousel-wrapper {
    position: relative;
    width: 100%;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
    width: 100%;
  }

  .web-project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: rgba(10, 16, 36, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .web-project-card:hover {
    border-color: var(--nhc-pink);
    transform: translateY(-6px);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.7), 0 0 25px rgba(255, 0, 127, 0.2);
  }

  .project-img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #050811;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-spring);
  }

  .web-project-card:hover .project-img {
    transform: scale(1.06);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background: rgba(4, 7, 17, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-fast);
    backdrop-filter: blur(4px);
  }

  .web-project-card:hover .project-overlay {
    opacity: 1;
  }

  .demo-overlay-btn {
    padding: 0.65rem 1.35rem;
    font-size: 0.9rem;
  }

  .project-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.65rem;
  }

  .project-header {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.25;
    color: #ffffff;
  }

  .project-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .tag-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--nhc-mint);
    padding: 0.22rem 0.6rem;
    border-radius: 4px;
    font-size: 0.74rem;
    font-family: var(--font-mono);
  }

  .project-actions {
    margin-top: 0.85rem;
  }

  .project-btn {
    width: 100%;
    padding: 0.65rem;
    font-size: 0.88rem;
  }

  .project-btn:hover {
    background: rgba(255, 0, 127, 0.12);
    border-color: var(--nhc-pink);
    color: #ffffff;
  }

  .mobile-only {
    display: none;
  }

  /* Mobile Swipeable Carousel with Autopass & Peek indicators */
  @media (max-width: 768px) {
    .mobile-only {
      display: flex;
    }

    .portfolio-section {
      padding: 3rem 0;
    }

    .projects-carousel-wrapper {
      margin: 0 -1rem;
      padding: 0 1rem;
    }

    .projects-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 1rem;
      padding: 0.5rem 0.5rem 1rem;
      scroll-padding: 0 1.25rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .projects-grid::-webkit-scrollbar {
      display: none;
    }

    .web-project-card {
      flex: 0 0 82vw;
      max-width: 320px;
      scroll-snap-align: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
      border: 1.5px solid var(--border-pink);
    }

    .project-content {
      padding: 1.25rem;
    }

    /* Carousel Nav Floating Buttons */
    .carousel-nav-btn {
      position: absolute;
      top: 45%;
      transform: translateY(-50%);
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(9, 15, 34, 0.92);
      border: 1px solid var(--border-pink);
      color: var(--nhc-pink-light);
      font-size: 1.3rem;
      font-weight: 800;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      z-index: 10;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(8px);
    }

    .prev-btn {
      left: 0.25rem;
    }

    .next-btn {
      right: 0.25rem;
    }

    /* Indicators */
    .carousel-indicators {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.45rem;
      margin-top: 0.75rem;
    }

    .indicator-dot {
      width: 8px;
      height: 8px;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.2);
      border: none;
      cursor: pointer;
      padding: 0;
      transition: width 0.3s ease, background 0.3s ease;
    }

    .indicator-dot.active {
      width: 24px;
      background: var(--nhc-pink);
      box-shadow: 0 0 10px var(--nhc-pink);
    }
  }
</style>
