---
import type { AppItem } from '../data/apps';

interface Props {
  app: AppItem;
}

const { app } = Astro.props;
---

<article class="app-card cyber-card" data-category={app.category}>
  <!-- Card Top Header -->
  <div class="card-header">
    <div class="app-icon-wrapper">
      <img
        src={app.icon}
        alt={`Icono de ${app.name}`}
        class="app-icon"
        width="76"
        height="76"
        loading="lazy"
      />
    </div>

    <div class="header-details">
      <div class="badges-row">
        <span class="badge badge-mint">{app.categoryLabel}</span>
        {app.featured && <span class="badge badge-pink">★ Top App</span>}
      </div>
      <h3 class="app-name">{app.name}</h3>
      <div class="meta-row">
        <div class="rating-box" aria-label={`Puntuación ${app.rating} de 5 estrellas`}>
          <span class="star-icon">★</span>
          <span class="rating-value">{app.rating.toFixed(1)}</span>
          {app.reviewsCount && <span class="reviews-count">({app.reviewsCount})</span>}
        </div>
        <span class="meta-divider">•</span>
        <button
          type="button"
          class="pkg-copy-btn"
          data-copy-text={app.id}
          title="Copiar Package ID de Android"
          aria-label="Copiar identificador de paquete"
        >
          <code>{app.id}</code>
          <svg class="copy-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Tagline & Description -->
  <p class="app-tagline">{app.tagline}</p>
  <p class="app-description">{app.description}</p>

  <!-- Features Highlight -->
  <div class="features-list">
    {app.features.map((feature) => (
      <div class="feature-item">
        <span class="feature-bullet">▸</span>
        <span>{feature}</span>
      </div>
    ))}
  </div>

  <!-- Screenshots preview strip -->
  <div class="screenshots-preview-section">
    <div class="preview-header">
      <span class="preview-label">Capturas de Pantalla</span>
      <button
        type="button"
        class="gallery-link"
        data-screenshot-trigger
        data-app-name={app.name}
        data-app-icon={app.icon}
        data-play-url={app.playStoreUrl}
        data-screenshots={JSON.stringify(app.screenshots)}
        data-start-index="0"
      >
        Ver galería ({app.screenshots.length}) →
      </button>
    </div>

    <div class="screenshots-strip">
      {app.screenshots.slice(0, 4).map((shot, index) => (
        <button
          type="button"
          class="shot-thumbnail-btn"
          data-screenshot-trigger
          data-app-name={app.name}
          data-app-icon={app.icon}
          data-play-url={app.playStoreUrl}
          data-screenshots={JSON.stringify(app.screenshots)}
          data-start-index={index}
          aria-label={`Ver captura de pantalla ${index + 1} de ${app.name}`}
        >
          <img
            src={shot}
            alt={`Captura ${index + 1} de ${app.name}`}
            class="shot-thumb-img"
            loading="lazy"
          />
        </button>
      ))}
    </div>
  </div>

  <!-- Card Actions -->
  <div class="card-actions">
    <a
      href={app.playStoreUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-mint play-cta"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3.609 1.814L13.793 12 3.61 22.186c-.36-.36-.61-.925-.61-1.637V3.451c0-.712.25-1.277.61-1.637zm11.305 9.066l2.124-2.124-9.923-5.73 7.799 7.854zm0 2.24l-7.799 7.854 9.923-5.73-2.124-2.124zm1.12-1.12l2.607 1.505c.789.456.789 1.198 0 1.654l-2.607 1.505-1.996-1.996 1.996-1.996z"/>
      </svg>
      <span>Instalar en Google Play</span>
    </a>
  </div>
</article>

<script>
  // Copy Package ID handler
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.pkg-copy-btn') as HTMLElement | null;
    if (btn) {
      const textToCopy = btn.dataset.copyText;
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy).then(() => {
          const originalContent = btn.innerHTML;
          btn.innerHTML = `<code>¡Copiado! ✓</code>`;
          btn.style.borderColor = '#00f5b8';
          setTimeout(() => {
            btn.innerHTML = originalContent;
            btn.style.borderColor = '';
          }, 1800);
        });
      }
    }
  });
</script>

<style>
  .app-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    border: 1.5px solid rgba(255, 255, 255, 0.08);
  }

  .card-header {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }

  .app-icon-wrapper {
    flex-shrink: 0;
    width: 76px;
    height: 76px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #090d18;
    border: 1.5px solid rgba(0, 245, 184, 0.25);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.4);
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .app-card:hover .app-icon-wrapper {
    transform: scale(1.05);
    border-color: var(--nhc-mint);
  }

  .app-icon {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .header-details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .badges-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .app-name {
    font-size: 1.28rem;
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    flex-wrap: wrap;
  }

  .rating-box {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 800;
    color: #fbbf24;
  }

  .star-icon {
    color: #fbbf24;
  }

  .rating-value {
    color: #ffffff;
  }

  .reviews-count {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .meta-divider {
    color: var(--text-muted);
  }

  .pkg-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 0.15rem 0.45rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .pkg-copy-btn:hover {
    background: rgba(0, 245, 184, 0.1);
    color: var(--nhc-mint);
    border-color: var(--nhc-mint);
  }

  .app-tagline {
    font-weight: 700;
    color: var(--nhc-mint);
    font-size: 0.95rem;
    margin-bottom: 0.6rem;
  }

  .app-description {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
    background: rgba(6, 9, 18, 0.5);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(0, 245, 184, 0.12);
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84rem;
    color: #cbd5e1;
  }

  .feature-bullet {
    color: var(--nhc-pink);
    font-weight: 800;
  }

  .screenshots-preview-section {
    margin-top: auto;
    margin-bottom: 1.5rem;
  }

  .preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .preview-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .gallery-link {
    background: none;
    border: none;
    color: var(--nhc-mint);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    padding: 0;
    transition: color var(--transition-fast);
  }

  .gallery-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .screenshots-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .shot-thumbnail-btn {
    background: #050811;
    border: 1.5px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .shot-thumbnail-btn:hover {
    transform: translateY(-2px) scale(1.04);
    border-color: var(--nhc-pink);
  }

  .shot-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-actions {
    margin-top: 0.5rem;
  }

  .play-cta {
    width: 100%;
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
  }
</style>
