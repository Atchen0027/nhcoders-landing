---
import { DEVELOPER_INFO } from '../data/apps';
---

<section id="contacto" class="contact-section">
  <div class="container">
    <div class="contact-layout">
      <!-- Left: Developer Information & Trust Badges -->
      <div class="developer-info-card cyber-card">
        <div class="card-badge-wrap">
          <span class="badge badge-mint">Soporte & Info</span>
        </div>
        <h2 class="contact-heading">Estudio & Contacto</h2>
        <p class="contact-intro">
          ¿Dudas técnicas, bugs o sugerencias? En <strong>{DEVELOPER_INFO.brandName}</strong> te responderemos lo antes posible.
        </p>

        <div class="info-items-list">
          <div class="info-item">
            <div class="info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <div class="info-text">
              <span class="info-label">Estudio</span>
              <strong class="info-val">{DEVELOPER_INFO.shortName}</strong>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="info-text">
              <span class="info-label">Ubicación</span>
              <strong class="info-val">{DEVELOPER_INFO.location}</strong>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div class="info-text">
              <span class="info-label">Email</span>
              <a href={`mailto:${DEVELOPER_INFO.email}`} class="info-val info-link">{DEVELOPER_INFO.email}</a>
            </div>
          </div>
        </div>

        <!-- Trust Badges -->
        <div class="trust-grid">
          <div class="trust-pill">
            <span class="trust-icon">👾</span>
            <span>Desarrollo independiente</span>
          </div>
          <div class="trust-pill">
            <span class="trust-icon">🔒</span>
            <span>100% Privacidad protegida</span>
          </div>
          <div class="trust-pill">
            <span class="trust-icon">⚡</span>
            <span>Android 14/15/16 Ready</span>
          </div>
        </div>
      </div>

      <!-- Right: Direct Message Form -->
      <div class="contact-form-card cyber-card">
        <h3 class="form-title">Envíanos un Mensaje</h3>
        <p class="form-subtitle">Llega directo a <strong>{DEVELOPER_INFO.email}</strong>.</p>

        <form id="developer-contact-form" class="contact-form" action={`https://formsubmit.co/${DEVELOPER_INFO.email}`} method="POST">
          <input type="hidden" name="_subject" value="Nuevo mensaje desde la Landing de Noobs Hard Coders" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />

          <div class="form-group">
            <label for="name" class="form-label">Nombre</label>
            <input type="text" id="name" name="name" required class="form-input" placeholder="Tu nombre" />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" required class="form-input" placeholder="tu-email@ejemplo.com" />
          </div>

          <div class="form-group">
            <label for="appSelect" class="form-label">App</label>
            <select id="appSelect" name="app" class="form-input form-select">
              <option value="General">Consulta General</option>
              <option value="FitKiva">FitKiva</option>
              <option value="Control de Gastos Compartidos">Control de Gastos</option>
              <option value="Taekwondo Master Quiz">Taekwondo Quiz</option>
              <option value="EbookPlayer">EbookPlayer</option>
              <option value="Aquí no hay quien duerma">Aquí no hay quien duerma</option>
              <option value="Simple PDF Editor">Simple PDF Editor</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message" class="form-label">Mensaje</label>
            <textarea id="message" name="message" rows="3" required class="form-input" placeholder="Escribe aquí tu consulta o sugerencia..."></textarea>
          </div>

          <div id="form-feedback" class="form-feedback" style="display: none;"></div>

          <button type="submit" id="form-submit-btn" class="btn btn-mint form-submit-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            <span>Enviar Mensaje</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Asynchronous Form Submission
  const form = document.getElementById('developer-contact-form') as HTMLFormElement | null;
  const feedbackEl = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;

  if (form && feedbackEl && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const originalBtnHtml = submitBtn.innerHTML;

      submitBtn.disabled = true;
      submitBtn.innerHTML = `<span>Enviando... ⏳</span>`;
      feedbackEl.style.display = 'none';

      try {
        const response = await fetch(form.action.replace('https://formsubmit.co/', 'https://formsubmit.co/ajax/'), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(Object.fromEntries(formData.entries()))
        });

        if (response.ok) {
          feedbackEl.className = 'form-feedback success';
          feedbackEl.innerHTML = `✅ <strong>¡Mensaje enviado con éxito!</strong> Nos pondremos en contacto contigo pronto.`;
          feedbackEl.style.display = 'block';
          form.reset();
        } else {
          throw new Error('Respuesta no exitosa');
        }
      } catch (err) {
        feedbackEl.className = 'form-feedback success';
        feedbackEl.innerHTML = `✅ <strong>¡Enviado!</strong> Revisa tu correo si es tu primera activación en FormSubmit.`;
        feedbackEl.style.display = 'block';
        form.submit();
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnHtml;
      }
    });
  }
</script>

<style>
  .contact-section {
    padding: 2rem 0 5rem;
    contain: content;
  }

  /* 2-Column Grid Layout */
  .contact-layout {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    width: 100%;
  }

  .developer-info-card, .contact-form-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-subtle);
    background: #0d1424;
    border-radius: var(--radius-md);
    min-width: 0;
  }

  .card-badge-wrap {
    margin-bottom: 0.6rem;
  }

  .contact-heading {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .contact-intro {
    font-size: 0.88rem;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .contact-intro strong {
    color: var(--nhc-mint);
  }

  .info-items-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .info-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(0, 245, 184, 0.12);
    border: 1px solid rgba(0, 245, 184, 0.25);
    color: var(--nhc-mint);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-text {
    min-width: 0;
    overflow: hidden;
  }

  .info-label {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 700;
  }

  .info-val {
    font-size: 0.88rem;
    color: #ffffff;
    word-break: break-word;
  }

  .info-link {
    color: var(--nhc-mint);
    transition: color var(--transition-fast);
  }

  .info-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  .trust-grid {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .trust-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  /* Form */
  .form-title {
    font-size: 1.35rem;
    margin-bottom: 0.35rem;
  }

  .form-subtitle {
    font-size: 0.84rem;
    margin-bottom: 1.25rem;
    color: var(--text-secondary);
  }

  .form-subtitle strong {
    color: var(--nhc-mint);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .form-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-secondary);
    font-family: var(--font-heading);
  }

  .form-input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    background: rgba(6, 9, 18, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.86rem;
    transition: border-color var(--transition-fast);
    box-sizing: border-box;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--nhc-mint);
    box-shadow: 0 0 0 2px rgba(0, 245, 184, 0.2);
  }

  .form-select {
    cursor: pointer;
  }

  .form-feedback {
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
  }

  .form-feedback.success {
    background: rgba(0, 245, 184, 0.12);
    border: 1px solid var(--nhc-mint);
    color: #e2e8f0;
  }

  .form-submit-btn {
    margin-top: 0.25rem;
    width: 100%;
    padding: 0.75rem;
    font-size: 0.9rem;
  }

  /* Mobile: 2-Column Grid adaptation */
  @media (max-width: 768px) {
    .contact-section {
      padding: 2rem 0 3.5rem;
    }

    .contact-layout {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.6rem;
    }

    .developer-info-card, .contact-form-card {
      padding: 1rem 0.75rem;
      border-radius: var(--radius-sm);
    }

    .contact-heading {
      font-size: 1.05rem;
      margin-bottom: 0.35rem;
    }

    .contact-intro {
      font-size: 0.75rem;
      margin-bottom: 0.85rem;
    }

    .info-items-list {
      gap: 0.65rem;
      margin-bottom: 1rem;
    }

    .info-icon {
      width: 28px;
      height: 28px;
    }

    .info-icon svg {
      width: 14px;
      height: 14px;
    }

    .info-label {
      font-size: 0.62rem;
    }

    .info-val {
      font-size: 0.75rem;
    }

    .trust-grid {
      padding-top: 0.75rem;
      gap: 0.35rem;
    }

    .trust-pill {
      font-size: 0.68rem;
      gap: 0.35rem;
    }

    .form-title {
      font-size: 1.05rem;
      margin-bottom: 0.2rem;
    }

    .form-subtitle {
      font-size: 0.72rem;
      margin-bottom: 0.75rem;
    }

    .contact-form {
      gap: 0.6rem;
    }

    .form-label {
      font-size: 0.7rem;
    }

    .form-input {
      padding: 0.45rem 0.55rem;
      font-size: 0.76rem;
    }

    .form-submit-btn {
      padding: 0.55rem;
      font-size: 0.78rem;
    }
  }

  @media (max-width: 380px) {
    .contact-layout {
      gap: 0.4rem;
    }
    .developer-info-card, .contact-form-card {
      padding: 0.75rem 0.5rem;
    }
  }
</style>
