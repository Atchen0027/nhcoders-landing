---
import { DEVELOPER_INFO, APPS } from '../data/apps';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero-section">
  <div class="container hero-content">
    <!-- Brand Mascot & Badge -->
    <div class="hero-mascot-wrapper">
      <div class="mascot-frame">
        <img
          src={`${base}/logo.png`}
          alt="Noobs Hard Coders Mascot Logo"
          class="hero-logo-img"
          width="420"
          height="280"
          loading="eager"
        />
      </div>
    </div>

    <div class="hero-badge-row">
      <span class="badge badge-mint">
        <span class="pulse-dot"></span>
        Indie Android Studio • Canarias, ES
      </span>
      <span class="badge badge-pink">
        100% Nativo & Sin Bloatware
      </span>
    </div>

    <h1 class="hero-title">
      Apps y juegos Android con <span class="text-gradient-brand">personalidad propia</span>
    </h1>

    <p class="hero-subtitle">
      En <strong>Noobs Hard Coders</strong> desarrollamos utilidades ligeras, herramientas de productividad y bienestar para tu día a día.
    </p>

    <!-- CTAs -->
    <div class="hero-cta-group">
      <a href="#apps" class="btn btn-mint hero-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Explorar Catálogo ({APPS.length})</span>
      </a>

      <a
        href={DEVELOPER_INFO.playStoreDeveloperUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-playstore hero-btn"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3.609 1.814L13.793 12 3.61 22.186c-.36-.36-.61-.925-.61-1.637V3.451c0-.712.25-1.277.61-1.637zm11.305 9.066l2.124-2.124-9.923-5.73 7.799 7.854zm0 2.24l-7.799 7.854 9.923-5.73-2.124-2.124zm1.12-1.12l2.607 1.505c.789.456.789 1.198 0 1.654l-2.607 1.505-1.996-1.996 1.996-1.996z"/>
        </svg>
        <span>Google Play Store</span>
      </a>
    </div>

    <!-- Stats Matrix -->
    <div class="hero-stats">
      <div class="stat-box">
        <span class="stat-val text-gradient-mint">{APPS.length} Apps</span>
        <span class="stat-lbl">Catálogo Oficial</span>
      </div>

      <div class="stat-box">
        <span class="stat-val text-gradient-pink">4.9 ★</span>
        <span class="stat-lbl">Valoración Media</span>
      </div>

      <div class="stat-box">
        <span class="stat-val text-gradient-mint">+5K</span>
        <span class="stat-lbl">Descargas</span>
      </div>

      <div class="stat-box">
        <span class="stat-val text-gradient-pink">0% Bloat</span>
        <span class="stat-lbl">Ligeras & Rápidas</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 3rem 0 3.5rem;
    overflow-x: clip;
    text-align: center;
    contain: content;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-mascot-wrapper {
    margin-bottom: 1.25rem;
    position: relative;
  }

  .hero-logo-img {
    max-width: 280px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0, 245, 184, 0.25)) drop-shadow(0 4px 12px rgba(255, 0, 127, 0.2));
    transition: transform 0.3s ease;
  }

  .hero-logo-img:hover {
    transform: scale(1.03) rotate(-1deg);
  }

  .hero-badge-row {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background-color: var(--nhc-mint);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--nhc-mint);
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.2); }
  }

  .hero-title {
    font-size: clamp(1.8rem, 5vw, 3.2rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    max-width: 820px;
    margin-bottom: 1rem;
    line-height: 1.15;
  }

  .hero-subtitle {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    max-width: 650px;
    margin-bottom: 2rem;
    color: var(--text-secondary);
  }

  .hero-subtitle strong {
    color: var(--nhc-mint);
  }

  .hero-cta-group {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
    width: 100%;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: 850px;
  }

  .stat-box {
    background: var(--bg-card);
    border: 1px solid rgba(0, 245, 184, 0.2);
    border-radius: var(--radius-md);
    padding: 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .stat-box:hover {
    border-color: var(--nhc-mint);
  }

  .stat-val {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 900;
  }

  .stat-lbl {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 2rem 0 2.5rem;
    }

    .hero-logo-img {
      max-width: 220px;
    }

    .hero-stats {
      grid-template-columns: repeat(4, 1fr);
      gap: 0.4rem;
    }

    .stat-box {
      padding: 0.6rem 0.35rem;
    }

    .stat-val {
      font-size: 1.1rem;
    }

    .stat-lbl {
      font-size: 0.65rem;
    }

    .hero-cta-group {
      flex-direction: column;
      gap: 0.6rem;
      max-width: 320px;
    }

    .hero-btn {
      width: 100%;
      padding: 0.65rem 1rem;
      font-size: 0.88rem;
    }
  }

  @media (max-width: 480px) {
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }
  }
</style>
