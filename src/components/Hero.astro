---
import { DEVELOPER_INFO, APPS } from '../data/apps';
---

<section class="hero-section">
  <!-- Dynamic Brand Glows -->
  <div class="glow-mint" aria-hidden="true"></div>
  <div class="glow-pink" aria-hidden="true"></div>

  <div class="container hero-content">
    <!-- Brand Mascot & Badge -->
    <div class="hero-mascot-wrapper">
      <div class="mascot-frame">
        <img
          src="/logo.png"
          alt="Noobs Hard Coders Mascot Logo"
          class="hero-logo-img"
          width="420"
          height="280"
          loading="eager"
        />
      </div>
    </div>

    <div class="hero-badge-row">
      <span class="badge badge-mint">
        <span class="pulse-dot"></span>
        Indie Android Studio • Canarias, ES
      </span>
      <span class="badge badge-pink">
        100% Nativo & Sin Bloatware
      </span>
    </div>

    <h1 class="hero-title">
      Desarrollando apps y juegos Android con <span class="text-gradient-brand">personalidad propia</span>
    </h1>

    <p class="hero-subtitle">
      En <strong>Noobs Hard Coders</strong> creamos herramientas ligeras, juegos interactivos y utilidades diseñadas para resolver problemas reales y entretener sin rodeos.
    </p>

    <!-- CTAs -->
    <div class="hero-cta-group">
      <a href="#apps" class="btn btn-mint">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Ver Todas las Apps ({APPS.length})</span>
      </a>

      <a
        href={DEVELOPER_INFO.playStoreDeveloperUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-playstore"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3.609 1.814L13.793 12 3.61 22.186c-.36-.36-.61-.925-.61-1.637V3.451c0-.712.25-1.277.61-1.637zm11.305 9.066l2.124-2.124-9.923-5.73 7.799 7.854zm0 2.24l-7.799 7.854 9.923-5.73-2.124-2.124zm1.12-1.12l2.607 1.505c.789.456.789 1.198 0 1.654l-2.607 1.505-1.996-1.996 1.996-1.996z"/>
        </svg>
        <span>Ficha en Google Play</span>
      </a>
    </div>

    <!-- Stats Matrix -->
    <div class="hero-stats">
      <div class="stat-box">
        <span class="stat-val text-gradient-mint">{APPS.length} Apps</span>
        <span class="stat-lbl">Publicadas y Activas</span>
      </div>

      <div class="stat-box">
        <span class="stat-val text-gradient-pink">4.9 ★</span>
        <span class="stat-lbl">Valoración Media</span>
      </div>

      <div class="stat-box">
        <span class="stat-val text-gradient-mint">+5K</span>
        <span class="stat-lbl">Descargas Globales</span>
      </div>

      <div class="stat-box">
        <span class="stat-val text-gradient-pink">0% Bloat</span>
        <span class="stat-lbl">Ligeras & Rápidas</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 3.5rem 0 4.5rem;
    overflow: hidden;
    text-align: center;
  }

  .glow-mint {
    position: absolute;
    top: 5%;
    left: 30%;
    transform: translateX(-50%);
    width: 500px;
    height: 380px;
    background: radial-gradient(circle, rgba(0, 245, 184, 0.18) 0%, transparent 70%);
    filter: blur(60px);
    z-index: 0;
    pointer-events: none;
  }

  .glow-pink {
    position: absolute;
    top: 15%;
    right: 25%;
    width: 450px;
    height: 350px;
    background: radial-gradient(circle, rgba(255, 0, 127, 0.16) 0%, transparent 70%);
    filter: blur(60px);
    z-index: 0;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-mascot-wrapper {
    margin-bottom: 1.5rem;
    position: relative;
  }

  .hero-logo-img {
    max-width: 320px;
    height: auto;
    filter: drop-shadow(0 10px 30px rgba(0, 245, 184, 0.25)) drop-shadow(0 5px 15px rgba(255, 0, 127, 0.2));
    transition: transform 0.3s ease;
  }

  .hero-logo-img:hover {
    transform: scale(1.03) rotate(-1deg);
  }

  .hero-badge-row {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--nhc-mint);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--nhc-mint);
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  .hero-title {
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    max-width: 880px;
    margin-bottom: 1.25rem;
    line-height: 1.12;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    max-width: 700px;
    margin-bottom: 2.5rem;
    color: var(--text-secondary);
  }

  .hero-subtitle strong {
    color: var(--nhc-mint);
  }

  .hero-cta-group {
    display: flex;
    gap: 1.2rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    width: 100%;
    max-width: 900px;
  }

  .stat-box {
    background: var(--bg-card);
    border: 1.5px solid rgba(0, 245, 184, 0.2);
    border-radius: var(--radius-md);
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: var(--shadow-card);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .stat-box:hover {
    transform: translateY(-3px);
    border-color: var(--nhc-mint);
    box-shadow: var(--shadow-mint);
  }

  .stat-val {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 900;
  }

  .stat-lbl {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-logo-img {
      max-width: 240px;
    }
  }
</style>
