---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AppsGrid from '../components/AppsGrid.astro';
import WebProjectsSection from '../components/WebProjectsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import DeveloperContact from '../components/DeveloperContact.astro';
---

<Layout
  title="AtchenDev | Desarrollo Web & Apps Android (Noobs Hard Coders)"
  description="Portfolio oficial de Atchen Valladares (AtchenDev): servicios de desarrollo web moderno (Astro, Next.js, React), catálogo de apps Android en Google Play de Noobs Hard Coders y proyectos a medida."
>
  <!-- LAYER 1: Web Development Hero & Services (Main Entrance) -->
  <div class="parallax-section-layer layer-main">
    <div class="parallax-floating-orb orb-main" aria-hidden="true"></div>
    <Hero />
    <ServicesSection />
  </div>

  <!-- LAYER 2: Dedicated Android Studio (Noobs Hard Coders - Overlaps Layer 1 with Mint Neon Aura) -->
  <div class="parallax-section-layer layer-android">
    <div class="parallax-floating-orb orb-android" aria-hidden="true"></div>
    <AppsGrid />
  </div>

  <!-- LAYER 3: Web Development Portfolio (AtchenDev - Overlaps Layer 2 with Magenta Aura) -->
  <div class="parallax-section-layer layer-portfolio">
    <div class="parallax-floating-orb orb-portfolio" aria-hidden="true"></div>
    <WebProjectsSection />
  </div>

  <!-- LAYER 4: About & Unified Contact (Overlaps Layer 3 with Obsidian Base) -->
  <div class="parallax-section-layer layer-about-contact">
    <div class="parallax-floating-orb orb-contact" aria-hidden="true"></div>
    <AboutSection />
    <DeveloperContact />
  </div>
</Layout>
